# LazyMorning Configuration
DATABASE_URL=sqlite:///./data/lazymorning.db

# AI Provider: 'ollama' (Local or Cloudflare Tunnel) or 'cloudflare_workers_ai'
AI_PROVIDER=ollama

# Ollama / Cloudflare Tunnel Settings
# Enter your Cloudflare Tunnel URL (e.g. https://your-tunnel.trycloudflare.com) or local (http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloudflare Access / Zero Trust Headers (Optional, if your tunnel is protected)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
CF_BEARER_TOKEN=

# Cloudflare Workers AI Settings (Optional, to run Qwen on Cloudflare serverless edge)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_WORKERS_AI_MODEL=@cf/qwen/qwen2.5-7b-instruct

# Scheduler Settings
BRIEFING_TIME=06:30
TIMEZONE=Asia/Kolkata
ENABLE_SCHEDULE=true
